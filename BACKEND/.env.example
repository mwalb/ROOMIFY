# ===============================
# ROOMIFY BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and configure your secret values.
# DO NOT commit real secrets or credentials into version control!
# ===============================

# Server Configuration
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# Database Configuration (Defaults to embedded H2 if omitted)
# For production (PostgreSQL / MySQL):
# DB_URL=jdbc:postgresql://localhost:5432/roomify
# DB_USERNAME=roomify_backend
# DB_PASSWORD=your_secure_db_password
# DB_DRIVER=org.postgresql.Driver
# JPA_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

DB_URL=jdbc:h2:file:./data/roomifydb;MODE=MySQL;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
JPA_PLATFORM=org.hibernate.dialect.H2Dialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Security & JWT Configuration
# Generate a cryptographically strong 256-bit or 512-bit secret for production
JWT_SECRET=RoomifyJWTSecretKey2026UltraSecureAuthenticationSystemKeyXYZ123456789
JWT_EXPIRATION=86400000

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=

# Google Gemini API Key for AI Room Designer & Arranger
GEMINI_API_KEY=AIzaSyD7ltIeJn7lFlWw-Pqxv12ULSapm4XcTOM
GEMINI_MODEL=gemini-1.5-flash

# File Storage Configuration
FILE_UPLOAD_DIR=uploads
